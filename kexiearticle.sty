\newcommand{\@email}{}
\newcommand{\kexietwodigits}[1]{\ifnum#1<10 0\fi\number#1}
\newcommand{\@articledate}{\number\year-\kexietwodigits{\month}-\kexietwodigits{\day}}
\newcommand{\@keywords}{}
\newcommand{\shorttitle}[1]{\renewcommand{\@shorttitle}{#1}}
\newcommand{\affiliation}[1]{\renewcommand{\@affiliation}{#1}}
\newcommand{\email}[1]{\renewcommand{\@email}{#1}}
\newcommand{\articledate}[1]{\renewcommand{\@articledate}{#1}}
\newcommand{\keywords}[1]{\renewcommand{\@keywords}{#1}}

% C3I-style author roles. Add a matching superscript to the author name, then
% declare its meaning with \role, for example \role[*]{Equal Contribution.}.
\newcounter{kexierole}
\newcommand{\role}[2][]{%
  \stepcounter{kexierole}%
  \expandafter\gdef\csname kexieroletext\thekexierole\endcsname{#2}%
  \if\relax\detokenize{#1}\relax
    \expandafter\gdef\csname kexierolelabel\thekexierole\endcsname{}%
  \else
    \expandafter\gdef\csname kexierolelabel\thekexierole\endcsname{$^{#1}$}%
  \fi
}
\newcommand{\@kexieroles}{%
  \ifnum\value{kexierole}>0
    \vspace{1pt}%
    {\centering\fontsize{9}{11}\selectfont\bfseries
      \@tempcnta=1
      \loop
        \csname kexierolelabel\the\@tempcnta\endcsname
        \csname kexieroletext\the\@tempcnta\endcsname
        \advance\@tempcnta by 1
        \ifnum\@tempcnta>\value{kexierole}\else\hspace{1.5em}\fi
      \ifnum\@tempcnta>\value{kexierole}\else\repeat
      \par}%
  \fi
}

\newcommand{\kexiemark}{%
  \includegraphics[height=15mm]{assets/thu-logo.pdf}%
  \headerlogosep
  \includegraphics[height=15mm]{assets/cst-logo.pdf}%
  \headerlogosep
  \includegraphics[height=15mm]{assets/sast-icon.png}%
}

% The title header accepts any number of marks. The three official marks are
% the default so the template works without additional image files.
\newcommand{\headerlogos}{\kexiemark}
\newcommand{\setheaderlogos}[1]{\gdef\headerlogos{#1}}
\newcommand{\headerlogosep}{\hspace{4mm}}

\newcommand{\makekexietitle}{%
  \thispagestyle{empty}%
  \par\noindent\hbox to \linewidth{%
    \headerlogos\hfil
    \begin{tabular}[c]{@{}r@{}}
      {\fontsize{15}{17}\selectfont\color{KXInk}\@articledate}
    \end{tabular}%
  }\par
  \vspace{2pt}
  \noindent{\color{KXLine}\rule{\linewidth}{0.45pt}}\par
  \vspace{6pt}
  \begingroup
    \centering
    {\fontsize{19.5}{21.5}\selectfont\bfseries\color{KXInk}\@title\par}
    \vspace{5pt}
    {\fontsize{11.5}{13}\selectfont\bfseries\@author\par}
    \vspace{1pt}
    \ifx\@affiliation\@empty\else
      {\fontsize{10.5}{12.3}\selectfont\color{KXMuted}\@affiliation\par}
    \fi
    \@kexieroles
    \ifx\@email\@empty\else
      {\fontsize{10.5}{12.3}\selectfont\href{mailto:\@email}{\@email}\par}
    \fi
    \vspace{5pt}
  \endgroup
}

\renewenvironment{abstract}{%
  \begin{tcolorbox}[
    enhanced,
    breakable,
    colback=KXSoft,
    colframe=KXLine,
    boxrule=0.4pt,
    arc=0pt,
    left=2.5mm,right=2.5mm,top=1.5mm,bottom=1.5mm,
    before skip=0pt,after skip=6pt,
    borderline west={1.2pt}{0pt}{KXAccent}
  ]
  \small\textbf{Abstract.}\enspace
}{%
  \ifx\@keywords\@empty\else
    \par\smallskip
    {\footnotesize\bfseries Keywords:}\enspace
    {\footnotesize\@keywords}
  \fi
  \end{tcolorbox}
}

