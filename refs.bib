% ---------------------------------------------------------------------------
% Off-policy sample reuse. Used for the precise version of the information-per-
% sample argument: policy gradient updates a batch once and discards it, while
% off-policy methods reuse it -- so a comparison against policy gradient alone
% confounds "symbolic vs neural" with "on-policy vs off-policy". Model-based
% RL is therefore the primary baseline and policy gradient the on-policy
% reference point.
% ---------------------------------------------------------------------------
% Cited for the plain fact that LLM RL is largely on-policy: a batch is used for
% one update, then discarded. VERIFIED 2026-08-18, and the abstract is almost
% our sentence: prevailing methods are "largely on-policy", they "update each
% batch of data only once, discard it, and then collect fresh samples,
% resulting in poor sample efficiency". Note what the paper itself proposes
% (ReVal, value-based, replay-buffer-compatible) -- we cite the premise it
% argues against, which is legitimate but means the paper is evidence that the
% field is moving off-policy, not that it will stay on-policy. If a referee
% presses, that is an argument for our choice of a model-based (off-policy)
% primary baseline, not against it.
@article{offpolicyvaluellm2026,
  title  = {Off-Policy Value-Based Reinforcement Learning for Large Language
            Models},
  author = {Wang, Peng-Yuan and Li, Ziniu and Xu, Tian and Yang, Bohan and
            Liu, Tian-Shuo and Wang, ChenYang and Chen, Xiong-Hui and
            Li, Yi-Chen and Yang, Tianyun and Chen, Congliang and Yu, Yang},
  journal = {arXiv preprint arXiv:2603.23355},
  year   = {2026}
}

% The other half of that pair: cited for the plain fact that off-policy methods
% reuse a batch across updates, which is what places a maintained program at the
% far end of the same spectrum rather than off it. Deliberately a theory paper
% on sample reuse and not a specific algorithm -- the intro's claim is about the
% spectrum, so citing one algorithm would invite "why that one?".
%
% VERIFIED against the full text 2026-08-18. The abstract alone does NOT support
% our sentence -- it mentions sample reuse only as a property it wants to borrow
% -- but Section I and Section II-B do, in the words we need: off-policy deep RL
% "achieve[s] data efficiency through the use of a replay buffer during
% training, which allows samples to be used for multiple policy updates", by
% "aggressively reusing samples for many policy updates", while "on-policy deep
% RL algorithms, on the other hand, only use data collected under the current
% policy". Cite the paper, not its abstract, if the claim is ever questioned.
@article{samplereuse2022,
