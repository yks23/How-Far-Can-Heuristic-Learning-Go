% Load-bearing for a reason that is easy to misread, so read this before
% moving the citation. ECHO rewrites its own failed trajectories into
% synthetic successes and keeps them in compressed memory -- no weight
% updates, and no program. It therefore isolates the lower-bound mechanism
% from the artifact: an LM extracting more signal per failed episode than a
% scalar reward carries is enough on its own to improve sample efficiency.
% Cite it exactly there, as the reason the information-per-sample gain is NOT
% evidence for symbolic policies specifically, which is the objection a
% referee raises next ("then why the program at all?"). The answer the intro
% gives is that the program is what makes the artifact editable, i.e. the
% upper bound, and that is where HL's contribution sits.
% Non-adversarial: single-agent XMiniGrid plus cooperative PeopleJoinQA. The
% headline "up to 80%" is against vanilla LM agents, not against RL, and the
% abstract does not name the metric -- do not repeat the number.
% Re-checked 2026-08-18 and all of the above holds. Confirmed additionally:
% the mechanism is prompting plus "an update rule that maintains compressed
% trajectory representations in memory" -- no gradient updates anywhere, which
% is exactly the property that makes it isolate the channel from the artifact.
% Its stronger comparisons (Reflexion, AWM) are other agent architectures and
% appear on XMiniGrid only; NO RL baseline exists in the paper. So it supports
% "the reader earns the efficiency" and cannot be used for any claim about
% magnitude relative to RL. That comparison is ours to make.
% ---------------------------------------------------------------------------
@article{echo2025hindsight,
  title   = {Sample-Efficient Online Learning in {LM} Agents via Hindsight
             Trajectory Rewriting},
  author  = {Hu, Michael Y. and Van Durme, Benjamin and Andreas, Jacob and
             Jhamtani, Harsh},
  journal = {arXiv preprint arXiv:2510.10304},
  year    = {2025},
  note    = {v2 January 2026; memory-based, no program and no weight updates}
}

