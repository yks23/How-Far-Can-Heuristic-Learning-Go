% ---------------------------------------------------------------------------
% Survey of 1,250 papers (2024-2026). Two things we use: bounded
% self-refinement is separated from open-ended recursive self-improvement, and
% the evaluator design space is ordered into a verification hierarchy from
% formal verifiers (strongest) to intrinsic self-assessment (weakest), with
% demonstrated self-improvement correlating with position in that hierarchy.
% Our loop sits at the strong end -- a game engine adjudicates, and the
% opponent pool is frozen -- which is the principled reason to expect it to
% work where research-agent loops stall.
% ---------------------------------------------------------------------------
@article{selfimprovement2026survey,
  title  = {From Bounded Self-Refinement to Autonomous Research Loops},
  author = {Chen, Mingguang and Wang, Licheng and Qu, Bo},
  journal = {arXiv preprint arXiv:2607.07663},
  year   = {2026}
}

